<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Required by the Mac App Store. The notch window, the microphone and on-device speech all work inside it. -->
	<key>com.apple.security.app-sandbox</key>
	<true/>
	<!-- Voice scrolling and "follow my words". -->
	<key>com.apple.security.device.audio-input</key>
	<true/>
	<!-- Scripts live in this group container, where every earlier version of Notchy saved them. -->
	<key>com.apple.security.application-groups</key>
	<array>
		<string>TJ7XUV6VQ9.com.notchy</string>
	</array>
	<!-- Exporting scripts to a file or folder the user picks. -->
	<key>com.apple.security.files.user-selected.read-write</key>
	<true/>
	<!-- The GitHub release check in the direct-download build. The App Store build compiles it out. -->
	<key>com.apple.security.network.client</key>
	<true/>
</dict>
</plist>
